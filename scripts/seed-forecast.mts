// Writes supabase/seeds/08_forecast.sql from the exported forecast
// (data/forecast/out), so `pnpm db:reset` loads it without `pnpm import:forecast`.
// Usage: pnpm seed:forecast [dir]. Re-run after retraining.

import { readFile, writeFile } from "node:fs/promises";
import { join } from "node:path";
import {
  assertForecastMetrics,
  parseArrivalsCsv,
} from "../src/modules/forecast/logic.ts";

const dir = process.argv[2] ?? join("data", "forecast", "out");
const out = join("supabase", "seeds", "08_forecast.sql");

const rows = parseArrivalsCsv(
  await readFile(join(dir, "arrivals.csv"), "utf8"),
);
const metrics: unknown = JSON.parse(
  await readFile(join(dir, "metrics.json"), "utf8"),
);
assertForecastMetrics(metrics);

const quote = (s: string) => `'${s.replaceAll("'", "''")}'`;
const values = rows
  .map(
    (r) =>
      `(${quote(r.psgcCode)},${quote(r.date)},${r.kgLow},${r.kgMid},${r.kgHigh},${quote(r.source)})`,
  )
  .join(",\n");

const sql = `-- M8. Forecast: the trained export (data/forecast/out), ${rows.length} rows.
-- Generated by \`pnpm seed:forecast\`; don't edit by hand. Dates are absolute
-- because arrivals follow the planting calendar: opa-2025 covers May 2025 to
-- Mar 2026 and demo-synthetic May 2026 to Mar 2027.

insert into public.forecast_arrivals (municipality_id, date, kg_low, kg_mid, kg_high, source)
select m.id, v.date::date, v.kg_low, v.kg_mid, v.kg_high, v.source::public.forecast_source
from (values
${values}
) as v (psgc_code, date, kg_low, kg_mid, kg_high, source)
join public.municipalities m on m.psgc_code = v.psgc_code;

insert into public.forecast_metrics (trained_on, metrics)
values (${quote(`${metrics.trained_on}T00:00:00+08:00`)}, ${quote(JSON.stringify(metrics))}::jsonb);
`;

await writeFile(out, sql);
console.log(`Wrote ${out}: ${rows.length} rows`);

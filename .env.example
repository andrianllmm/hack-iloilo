# Supabase (local values: `pnpm db:status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SMS: `simulator` (default) or `smsgate`
SMS_GATEWAY=simulator
SMSGATE_URL=
# From SMS Gateway Android app > Home > Cloud Server.
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
# Optional with one device; recommended to explicitly select the gateway phone.
SMS_GATEWAY_DEVICE_ID=
# Optional: 1 or 2 (SIM slot, not textbee's subscription ID).
SMS_GATEWAY_SIM_NUMBER=
# From Android app > Settings > Webhooks > Signing Key.
SMS_GATEWAY_WEBHOOK_SIGNING_KEY=
SMS_GATEWAY_WEBHOOK_PORT=3000

# Gemini (optional; AI falls back to templates)
GOOGLE_GENERATIVE_AI_API_KEY=
